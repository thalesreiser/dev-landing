---
import { temRastreamento } from '../lib/consentimento.ts';
import type { Conteudo, SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'rodape'>;
  conteudo: Conteudo;
  /** Leaves room at the bottom so the WhatsApp bar (mobile) or round button (desktop) never covers the last lines. */
  comBotaoFixo?: boolean;
}

const { secao, conteudo, comBotaoFixo = false } = Astro.props;
const { email } = conteudo.contato;
const ano = new Date().getFullYear();
const links = [...(secao.links ?? []), { texto: 'Política de privacidade', href: '/politica-de-privacidade' }];
const externo = (href: string) => /^https?:/.test(href);
---

<footer class:list={['superficie-escura bg-texto pt-12 text-fundo', comBotaoFixo ? 'pb-24 sm:pb-28' : 'pb-12']}>
  <div class="container-site grid gap-8 md:grid-cols-3">
    <div>
      <p class="font-titulo text-lg font-semibold">
        <span class="font-mono text-sm text-destaque-escuro" aria-hidden="true">&gt;_</span>
        {conteudo.site.nome}
      </p>
      {secao.texto && <p class="mt-3 text-sm opacity-80">{secao.texto}</p>}
    </div>
    <address class="text-sm not-italic opacity-80">
      <p>{conteudo.autor.cidade}/{conteudo.autor.uf}</p>
      <p class="mt-2"><a href={`mailto:${email}`} class="underline">{email}</a></p>
    </address>
    <nav aria-label="Rodapé">
      <ul class="space-y-2 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="underline opacity-80 hover:opacity-100"
                {...(externo(link.href) ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {link.texto}
              </a>
            </li>
          ))
        }
        {
          temRastreamento(conteudo.rastreamento) && (
            <li>
              {/* AvisoCookies.astro unhides it and reopens the banner on click. */}
              <button type="button" data-preferencias-cookies hidden class="cursor-pointer underline opacity-80 hover:opacity-100">
                Preferências de cookies
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
  <p class="container-site mt-10 text-xs opacity-80">© {ano} {conteudo.autor.nome}.</p>
</footer>
