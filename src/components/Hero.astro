---
import { atributosAcao } from '../lib/acao.ts';
import { ancoraSecao, type Conteudo, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'hero'>;
  conteudo: Conteudo;
}

const { secao, conteudo } = Astro.props;
const destaques = secao.destaques ?? [];
---

{/* data-hero: the WhatsApp shortcut stays hidden while this section is on screen. */}
<section id={ancoraSecao(secao)} class="secao fundo-grade" data-hero>
  <div class:list={['container-site grid items-center gap-10', destaques.length > 0 && 'lg:grid-cols-[1.35fr_1fr] lg:gap-14']}>
    <div>
      {secao.selo && <p class="rotulo-mono mb-4">{secao.selo}</p>}
      <h1 class="text-[2rem] leading-[1.15] font-semibold tracking-tight sm:text-5xl sm:leading-tight lg:text-[3.25rem] lg:leading-[1.08]">
        {secao.titulo}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-texto-suave">{secao.subtitulo}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a {...atributosAcao(secao.acao_principal, conteudo.contato)} class="botao-primario">
          {secao.acao_principal.texto}
        </a>
        {
          secao.acao_secundaria && (
            <a {...atributosAcao(secao.acao_secundaria, conteudo.contato)} class="botao-secundario bg-fundo">
              {secao.acao_secundaria.texto}
            </a>
          )
        }
      </div>
    </div>
    {
      destaques.length > 0 && (
        <div class="superficie-escura overflow-hidden rounded-cartao bg-texto text-fundo shadow-xl">
          <div class="flex items-center gap-1.5 border-b border-fundo/15 px-4 py-3" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-fundo/30" />
            <span class="size-2.5 rounded-full bg-fundo/30" />
            <span class="size-2.5 rounded-full bg-fundo/30" />
          </div>
          <dl class="px-5 py-2 sm:px-6">
            {destaques.map((item) => (
              <div class="border-t border-fundo/10 py-4 first:border-t-0">
                <dt class="font-mono text-sm text-destaque-escuro">{item.rotulo}</dt>
                <dd class="mt-1 text-base">{item.valor}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </div>
</section>
