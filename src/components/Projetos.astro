---
import Icone from './Icone.astro';
import Imagem from './Imagem.astro';
import TituloSecao from './TituloSecao.astro';
import { ancoraSecao, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'projetos'>;
}

const { secao } = Astro.props;
const ancora = ancoraSecao(secao);
const idTitulo = `${ancora}-titulo`;
---

<section id={ancora} class="secao" aria-labelledby={idTitulo}>
  <div class="container-site">
    <TituloSecao id={idTitulo} ancora={ancora} titulo={secao.titulo} subtitulo={secao.subtitulo} />
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        secao.itens.map((projeto) => (
          <li class="cartao flex flex-col overflow-hidden p-0">
            {projeto.imagem ? (
              <Imagem
                imagem={projeto.imagem}
                sizes="(min-width: 768px) 34rem, calc(100vw - 2rem)"
                larguras={[480, 720, 1080]}
                class="aspect-[16/7] w-full object-cover"
              />
            ) : (
              <div class="fundo-grade-escura flex h-28 items-end justify-between bg-texto p-5 text-fundo" aria-hidden="true">
                <span class="font-mono text-sm text-destaque-escuro">~/{projeto.titulo}</span>
                <Icone nome={projeto.icone} class="size-10 opacity-70" />
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="font-mono text-lg font-semibold break-all">{projeto.titulo}</h3>
                {projeto.status && <span class="etiqueta border-destaque/40 font-semibold text-destaque">{projeto.status}</span>}
              </div>
              <p class="mt-3 text-texto-suave">{projeto.descricao}</p>
              <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologias de ${projeto.titulo}`}>
                {projeto.tags.map((tag) => (
                  <li class="etiqueta">{tag}</li>
                ))}
              </ul>
              <ul class="mt-auto flex flex-wrap gap-x-6 gap-y-1 pt-6">
                {projeto.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-primaria underline-offset-4 hover:underline"
                    >
                      {link.texto}
                      <Icone nome="externo" class="size-4" />
                      <span class="sr-only">(abre em nova aba)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
